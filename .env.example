# Example values for local development only. Replace before exposing the service.
DJANGO_SECRET_KEY=replace-this-local-development-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=replace-this-local-development-password

WEB_PORT=8000
CELERY_WORKER_CONCURRENCY=2
# Must exceed the longest task execution and any broker-held retry countdown.
CELERY_BROKER_VISIBILITY_TIMEOUT=300
