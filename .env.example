# Example values for local development only. Replace before exposing the service.
DJANGO_SECRET_KEY=replace-this-local-development-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=replace-this-local-development-password
# Maximum request wait for a pooled connection; connection setup runs in background.
POSTGRES_POOL_TIMEOUT=0.3

# Trusted origins only. The Docker web origin routes replies to the local mock.
HELPDESK_ALLOWED_ORIGINS=http://web:8000,https://helpdesk.example.com

WEB_PORT=8000
CELERY_WORKER_CONCURRENCY=2
# Must exceed the longest task execution and any broker-held retry countdown.
CELERY_BROKER_VISIBILITY_TIMEOUT=300

# Enabled for the demo; set false to pause generation and retain pending events.
GENERATION_ENABLED=true
GENERATION_RECONCILE_INTERVAL=5
# Optional GENERATION_MAX_INFLIGHT defaults to CELERY_WORKER_CONCURRENCY.
GENERATION_MAX_ATTEMPTS=3
GENERATION_MAX_DISPATCHES=10
GENERATION_QUEUE_LEASE_SECONDS=60
GENERATION_LEASE_SECONDS=120

# Public origin for links in drafts; change port here too if WEB_PORT changes.
PUBLIC_BASE_URL=http://localhost:8000
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# Empty key enables demo mode WITH a real unauthenticated HTTP attempt.
LLM_API_KEY=
LLM_HTTP_TIMEOUT=15
LLM_DEMO_DELAY_SECONDS=5
# Same key and Redis must be used by every worker sharing the LLM quota.
LLM_RATE_LIMIT_KEY=helpdesk:llm:global

# Delivery is independent of GENERATION_ENABLED.
DELIVERY_ENABLED=true
DELIVERY_HTTP_TIMEOUT=5
# Optional DELIVERY_MAX_INFLIGHT defaults to CELERY_WORKER_CONCURRENCY.
DELIVERY_MAX_ATTEMPTS=3
DELIVERY_MAX_DISPATCHES=10
DELIVERY_QUEUE_LEASE_SECONDS=60
DELIVERY_LEASE_SECONDS=120

# Local fault tests ONLY. Map exact Idempotency-Key values to fault modes.
MOCK_HELPDESK_FAULTS_ENABLED=false
MOCK_HELPDESK_FAULTS={}
MOCK_HELPDESK_FAULT_DELAY_SECONDS=10
